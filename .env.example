# ---- Server ----
PORT=5195
NODE_ENV=development            # set to "production" when deployed (enables secure cookies + HSTS)
PUBLIC_URL=http://localhost:5195 # the live site URL in production, e.g. https://kovalent.com (used in payment return links)
DATA_DIR=./data                 # database + uploaded photos; point at a persistent volume in production

# ---- First superadmin (created on first boot only; change the password after signing in) ----
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# ---- Stripe (cards, Apple Pay, Google Pay; US, Canada, Mexico, Brazil accounts) ----
STRIPE_SECRET_KEY=              # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=          # whsec_... from the webhook pointing at /api/webhooks/stripe

# ---- PayPal (most of the Americas) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox              # sandbox | live

# ---- Mercado Pago (MX, AR, BR, CL, CO, PE, UY) ----
MP_ACCESS_TOKEN=                # TEST-... for sandbox, APP_USR-... for live

# ---- Order emails via Resend (optional) ----
RESEND_API_KEY=
MAIL_FROM=                      # e.g. "Kovalent <orders@yourdomain.com>" (domain must be verified in Resend)
ORDER_NOTIFY_EMAIL=             # fallback if no notification email is set in the admin Settings
